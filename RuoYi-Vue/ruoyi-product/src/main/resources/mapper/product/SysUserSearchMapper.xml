<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.product.mapper.SysUserSearchMapper">

    <resultMap type="com.ruoyi.product.domain.vo.ProductUserVO" id="ProductUserVOResult">
        <result property="userId"      column="user_id"     />
        <result property="userName"    column="user_name"   />
        <result property="nickName"    column="nick_name"   />
        <result property="deptName"    column="dept_name"   />
        <result property="phonenumber" column="phonenumber" />
        <result property="email"      column="email"       />
    </resultMap>

    <!--
        轻量查询 sys_user，关联 sys_dept 取部门名称
        keyword 为空时返回近期用户（按 user_id desc）；非空时按 user_name/nick_name/phonenumber 模糊匹配
        sys_user 使用 del_flag(char '0') 表示未删除
    -->
    <select id="selectUserList" parameterType="String" resultMap="ProductUserVOResult">
        select u.user_id, u.user_name, u.nick_name, d.dept_name, u.phonenumber, u.email
        from sys_user u
        left join sys_dept d on u.dept_id = d.dept_id
        where u.del_flag = '0'
        <if test="keyword != null and keyword != ''">
            and (
                u.user_name like concat('%', #{keyword}, '%')
                or u.nick_name like concat('%', #{keyword}, '%')
                or u.phonenumber like concat('%', #{keyword}, '%')
            )
        </if>
        order by u.user_id desc
        limit 50
    </select>
</mapper>
